{
  "openapi": "3.0.1",
  "info": {
    "title": "Jikanzo Admin API",
    "description": "Admin dashboard API: login, KPI stats cards, booking & revenue trend chart. Protected routes require JWT with type=admin.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://192.168.22.78:3000/api",
      "description": "Deployed Server"
    },
    {
      "url": "http://localhost:7070/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AdminLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@jikanzo.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "ChangeMe123!"
          }
        }
      },
      "AdminDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "admin@jikanzo.com"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Platform Admin"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "MODERATOR",
              "SUPPORT"
            ],
            "example": "SUPER_ADMIN"
          }
        }
      },
      "AdminLoginResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "example": "Admin login successful"
          },
          "token": {
            "type": "string"
          },
          "admin": {
            "$ref": "#/components/schemas/AdminDto"
          }
        }
      },
      "AdminDashboardStatCard": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "totalClients",
              "totalCompanions",
              "newSignups",
              "activeBookings",
              "pendingVerifications",
              "openDisputes",
              "grossRevenue",
              "walletBalanceHeld"
            ]
          },
          "label": {
            "type": "string",
            "example": "Total Clients"
          },
          "description": {
            "type": "string",
            "example": "All registered clients."
          },
          "value": {
            "type": "number",
            "example": 3204
          },
          "formattedValue": {
            "type": "string",
            "description": "Present for currency cards",
            "example": "$214,483"
          },
          "trendPercent": {
            "type": "number",
            "description": "Percent change vs previous period of equal length",
            "example": 4.2
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "One point per day in the selected range"
          }
        }
      },
      "AdminDashboardStatsData": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date-time"
              },
              "endDate": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "viewerRole": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "MODERATOR",
              "SUPPORT"
            ]
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminDashboardStatCard"
            }
          }
        }
      },
      "AdminDashboardStatsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "example": "Dashboard stats fetched successfully"
          },
          "data": {
            "$ref": "#/components/schemas/AdminDashboardStatsData"
          }
        }
      },
      "AdminDashboardTrendPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-08-24"
          },
          "bookings": {
            "type": "integer",
            "description": "Bookings created on this day",
            "example": 12
          },
          "revenue": {
            "type": "number",
            "description": "Paid gross revenue for bookings created on this day",
            "example": 840.5
          }
        }
      },
      "AdminDashboardTrendsData": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date-time"
              },
              "endDate": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminDashboardTrendPoint"
            }
          }
        }
      },
      "AdminDashboardTrendsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "example": "Booking and revenue trend fetched successfully"
          },
          "data": {
            "$ref": "#/components/schemas/AdminDashboardTrendsData"
          }
        }
      },
      "AdminTrustTierSegment": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "New",
              "Verified",
              "Trusted",
              "Premium"
            ]
          },
          "label": {
            "type": "string",
            "example": "Verified"
          },
          "count": {
            "type": "integer",
            "example": 120
          },
          "percent": {
            "type": "number",
            "description": "Share of all companions (0–100)",
            "example": 42.5
          }
        }
      },
      "AdminTrustTierDistributionData": {
        "type": "object",
        "properties": {
          "totalCompanions": {
            "type": "integer",
            "example": 282
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminTrustTierSegment"
            }
          }
        }
      },
      "AdminTrustTierDistributionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "example": "Trust tier distribution fetched successfully"
          },
          "data": {
            "$ref": "#/components/schemas/AdminTrustTierDistributionData"
          }
        }
      },
      "AdminNeedsAttentionItem": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "pendingVerification",
              "disputesAwaitingDecision",
              "refundRequestsPending",
              "trackingViolationsFlagged"
            ]
          },
          "count": {
            "type": "integer",
            "example": 64
          },
          "title": {
            "type": "string",
            "example": "64 companions pending verification"
          },
          "description": {
            "type": "string",
            "example": "Applications are waiting for a manual review."
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "info",
              "danger"
            ]
          },
          "actionLabel": {
            "type": "string",
            "example": "Open Verification"
          }
        }
      },
      "AdminNeedsAttentionData": {
        "type": "object",
        "properties": {
          "activeAlertCount": {
            "type": "integer",
            "description": "Number of cards with count > 0",
            "example": 4
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminNeedsAttentionItem"
            }
          }
        }
      },
      "AdminNeedsAttentionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": true
          },
          "msg": {
            "type": "string",
            "example": "Needs attention list fetched successfully"
          },
          "data": {
            "$ref": "#/components/schemas/AdminNeedsAttentionData"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": false
          },
          "msg": {
            "type": "string",
            "example": "Something went wrong"
          }
        }
      },
      "ActivityInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "SubActivityInput": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ActivityModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Coffee Meetups"
          },
          "description": {
            "type": "string",
            "example": "Relaxing coffee meetup"
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SubActivityModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "activityId": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Coffee Cafe"
          },
          "description": {
            "type": "string",
            "example": "Coffee Cafe"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ActivityWithSubActivitiesModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ActivityModel"
          },
          {
            "type": "object",
            "properties": {
              "subActivities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SubActivityModel"
                }
              }
            }
          }
        ]
      },
      "BaseErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "example": false
          },
          "msg": {
            "type": "string",
            "example": "Server error or specific error message"
          }
        }
      }
    }
  },
  "paths": {
    "/admin/dashboard/stats": {
      "get": {
        "tags": [
          "Admin",
          "Dashboard"
        ],
        "operationId": "getAdminDashboardStats",
        "summary": "Admin dashboard KPI stats",
        "description": "Returns KPI cards (value, trendPercent, sparkline) for the selected date range. Cards are filtered by admin role. Default range: last 30 days.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Period start (ISO 8601). Defaults to 30 days before endDate."
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Period end (ISO 8601). Defaults to now."
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard stats fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDashboardStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/booking-and-revenue-trend": {
      "get": {
        "tags": [
          "Admin",
          "Dashboard"
        ],
        "operationId": "getAdminBookingAndRevenueTrend",
        "summary": "Booking and revenue trend",
        "description": "Daily series for the dashboard line chart: booking count (by createdAt) and paid revenue per day. Uses the same startDate/endDate as dashboard stats (default last 30 days).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Period start (ISO 8601). Defaults to 30 days before endDate."
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Period end (ISO 8601). Defaults to now."
          }
        ],
        "responses": {
          "200": {
            "description": "Trend fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDashboardTrendsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/trust-tier": {
      "get": {
        "tags": [
          "Admin",
          "Dashboard"
        ],
        "operationId": "getAdminTrustTierDistribution",
        "summary": "Trust tier distribution",
        "description": "Donut chart data: count and percent of all companions in each trust tier (New, Verified, Trusted, Premium). Current snapshot; not filtered by dashboard date range.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Trust tier distribution fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTrustTierDistributionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/needs-attention-list": {
      "get": {
        "tags": [
          "Admin",
          "Dashboard"
        ],
        "operationId": "getAdminNeedsAttentionList",
        "summary": "Needs attention alerts",
        "description": "Current operational queue for the dashboard alert grid. Counts: companions with trustRank New; bookings with extension PENDING; refund proxy (cancelled+paid bookings and failed extension payments); active bookings with failed payment (tracking proxy). Not filtered by dashboard date range.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Needs attention list fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminNeedsAttentionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/login": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin login",
        "description": "Email and password login for dashboard admins. JWT includes type=admin and role. Use Authorization: Bearer on protected admin routes with verifyAdmin middleware.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or inactive account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "status": false,
                  "msg": "Invalid email or password"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/activity": {
      "post": {
        "tags": [
          "Activity"
        ],
        "summary": "Create activity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Activity created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "msg": {
                      "type": "string",
                      "example": "Activity created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ActivityModel"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Activity"
        ],
        "summary": "Get all activities",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Activities fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "msg": {
                      "type": "string",
                      "example": "Activities fetched successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActivityModel"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/activity/{id}": {
      "put": {
        "tags": [
          "Activity"
        ],
        "summary": "Update activity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "msg": {
                      "type": "string",
                      "example": "Activity updated successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ActivityModel"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Activity"
        ],
        "summary": "Delete activity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "msg": {
                      "type": "string",
                      "example": "Activity deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
