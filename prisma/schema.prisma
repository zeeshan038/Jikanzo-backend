generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  CLIENT
  COMPANION
  BOTH
}

model User {
  id               Int               @id @default(autoincrement())
  cloudflareId     String?           @unique
  username         String            @unique
  phone            String            @unique
  profileImage     String?           @default("")
  role             Role              @default(CLIENT)
  walletBalance    Float             @default(0.0)
  about            String            @default("")
  languages        String[]          @default([])
  activityType     String[]          @default([])
  savedLocations   Json?             @default(dbgenerated("'[]'"))
  gender           String?           @default("")
  age              Int?              @default(0)
  gallery          String[]          @default([])
  intros           String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  companionProfile CompanionProfile?
  clientBookings   Booking[]         @relation("ClientBookings")
  momentViews      MomentView[]
  clientReviews    Review[]          @relation("ClientReviews")
  walletTransactions WalletTransaction[]
  savedCompanions  SavedCompanion[]  @relation("UserSavedCompanions")
  currentToken     String?
  fcmToken         String?
  feedStats        FeedStat[]        @relation("UserFeedStats")
}

model CompanionProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  
  bio         String?
  hourlyRate  Float?
  locationLat Float?
  locationLng Float?
  serviceRadius Int?     @default(10)
  bookingBufferMin Int   @default(60) // e.g., 30, 60, 90, 120
  isPaused       Boolean  @default(false)

  // UI Specific Fields
  isOnline       Boolean  @default(false)
  walletBalance  Float    @default(0.0)
  profileViews   Int      @default(0)
  rating         Float    @default(0.0)
  trustRank      String   @default("New") // "Premium", "New", etc.
  totalSessions  Int      @default(0)
  repeatClients  Int      @default(0)
  jssScore       Float?   @default(0.0)
  completedMeetups Int    @default(0)
  reliabilityScore Float  @default(100.0)
  

  // Relations
  bookings    Booking[] @relation("CompanionBookings")
  reviews     Review[]  @relation("CompanionReviews")
  savedBy     SavedCompanion[] @relation("SavedByUsers")
  moments     Moment[]  @relation("CompanionMoments")
  feedStats   FeedStat[] @relation("CompanionFeedStats")
  schedules           WeeklySchedule[]
  oneTimeAvailabilities OneTimeAvailability[]
  blockedDates        BlockedDate[]
}

model Booking {
  id           Int      @id @default(autoincrement())
  clientId     Int
  companionId  Int
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  latitude     Float?
  longitude    Float?
  address      String?
  activity     String?
  status       String   @default("PENDING") // PENDING, ACTIVE, COMPLETED, CANCELLED
  totalAmount  Float?
  otp          String?
  paymentStatus String  @default("PENDING") // PENDING, PAID, FAILED
  stripePaymentIntentId String?
  cancelledById Int?
  cancellationReason String?
  extensionStatus String   @default("NONE") // NONE, PENDING, ACCEPTED, DENIED
  extensionHours Int?
  extensionAmount Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       User             @relation("ClientBookings", fields: [clientId], references: [id])
  companion    CompanionProfile @relation("CompanionBookings", fields: [companionId], references: [id])
}

model Review {
  id           Int      @id @default(autoincrement())
  clientId     Int
  companionId  Int
  rating       Int
  comment      String?
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  client       User             @relation("ClientReviews", fields: [clientId], references: [id])
  companion    CompanionProfile @relation("CompanionReviews", fields: [companionId], references: [id])
}

model Otp {
  id         Int       @id @default(autoincrement())
  phone      String    @unique
  otp        String
  isVerified Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}


// model Notification {
//   id Int @id @default(autoincrement())
// }

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  type        String   // "CREDIT" or "DEBIT"
  description String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
}

model SavedCompanion {
  id          Int      @id @default(autoincrement())
  userId      Int
  companionId Int
  createdAt   DateTime @default(now())

  user        User             @relation("UserSavedCompanions", fields: [userId], references: [id])
  companion   CompanionProfile @relation("SavedByUsers", fields: [companionId], references: [id])

  @@unique([userId, companionId])
}

model Moment {
  id          Int      @id @default(autoincrement())
  companionId Int
  mediaUrl    String
  caption     String?
  likes       Int      @default(0)
  diamonds    Int      @default(0)
  rings       Int      @default(0)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  companion   CompanionProfile @relation("CompanionMoments", fields: [companionId], references: [id])
  views       MomentView[]
}

model MomentView {
  id        Int      @id @default(autoincrement())
  userId    Int
  momentId  Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([userId, momentId])
}

model FeedStat {
  id                     Int      @id @default(autoincrement())
  userId                 Int      // The customer
  companionId            Int      // The companion being viewed
  impressionsLast24h     Int      @default(0)
  top3AppearancesLast24h Int      @default(0)
  lastShownAt            DateTime @default(now())
  
  user                   User             @relation("UserFeedStats", fields: [userId], references: [id])
  companion              CompanionProfile @relation("CompanionFeedStats", fields: [companionId], references: [id])

  @@unique([userId, companionId])
}

model WeeklySchedule {
  id          Int      @id @default(autoincrement())
  companionId Int
  dayOfWeek   Int      // 0=Sunday, 1=Monday, etc.
  isAvailable Boolean  @default(true)
  startTime   String?  // Storing as "18:00" format
  endTime     String?  // Storing as "22:00" format

  companion   CompanionProfile @relation(fields: [companionId], references: [id])
  
  @@unique([companionId, dayOfWeek])
}

model OneTimeAvailability {
  id          Int      @id @default(autoincrement())
  companionId Int
  date        DateTime // e.g., Aug 17, 2025
  startTime   String   // "12:00"
  endTime     String   // "17:00"
  location    String?  // Optional location specific to this date

  companion   CompanionProfile @relation(fields: [companionId], references: [id])
}

model BlockedDate {
  id          Int      @id @default(autoincrement())
  companionId Int
  startDate   DateTime
  endDate     DateTime
  reason      String?  // e.g., "Vacation"

  companion   CompanionProfile @relation(fields: [companionId], references: [id])
}